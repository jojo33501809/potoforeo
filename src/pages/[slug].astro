---
import { Icon } from "astro-iconset/components";
import Base from "../../layouts/Base.astro";

interface WorkDetail {
	slug: string;
	title: string;
	summary: string;
	category: string;
	role: string;
	deliverables: string;
	period: string;
	tools: string[];
	thumbnail: string;
	background: string;
	approach: string;
	implementation: string[];
	result: string;
}

const works: WorkDetail[] = [
	{
		slug: "hubspot-modular-lp",
		title: "HubSpot CMS 汎用LPテンプレート・カスタムモジュール開発",
		summary: "非エンジニアの運用担当者でも管理画面から柔軟にページ構築・デザイン調整できる再利用可能なモジュール群を設計・実装。",
		category: "CMS / Architecture",
		role: "Frontend Coder",
		deliverables: "LPテンプレート / カスタムモジュール群 / 管理画面UI設計",
		period: "2025.05 - 現在",
		tools: ["HubSpot CMS", "HubL", "JavaScript", "fields.json", "CSS"],
		thumbnail: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80",
		background: "従来はLPを新規作成するたびにエンジニアが個別でHTML/CSSを実装しており、公開までのリードタイムと保守コストが課題となっていました。マーケターや運用担当者がコードを触らずに安全にページを量産・更新できる仕組みが求められていました。",
		approach: "複数案件で共通化できるUIパーツを洗い出し、HubSpot CMSのカスタムモジュールとしてコンポーネント化。非エンジニアが直感的に操作できるよう、fields.jsonによる設定項目のグループ化と管理画面内のヘルプテキスト設計に注力しました。",
		implementation: [
			"fields.jsonを活用し、ボタン種別・配色・角丸・余白を管理画面から安全に切り替えられるプロパティ設計を構築",
			"画面幅や文字数の増減に応じてタイトルの折り返しやレイアウトが崩れないレスポンシブCSS設計",
			"追従CTAやドロワーメニューなどのUI挙動におけるJavaScriptの初期化処理・イベント検知の不具合解消",
			"テキスト入力時の改行コードや不要なHTMLタグ混入を防ぐHubL側のサニタイズ・表示ロジック実装",
		],
		result: "新規LPの立ち上げ工数を大幅に削減し、運用担当者のみでレイアウト調整や文言更新が完結する体制を実現。コンポーネントの再利用性と運用性を両立する設計力を培いました。",
	},
	{
		slug: "workflow-automation-gas-node",
		title: "Node.js・GASを活用したCMSデータ連携および制作業務効率化",
		summary: "スプレッドシートの設定データとWebページ情報の自動連携や、HubSpotへのファイル反映フローを構築し運用工数を削減。",
		category: "Automation",
		role: "Frontend / Tooling",
		deliverables: "データ連携スクリプト / 自動反映CLIツール",
		period: "2025.08 - 現在",
		tools: ["Node.js", "GAS", "JavaScript", "JSON", "Git"],
		thumbnail: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1200&q=80",
		background: "複数ページの設定データやアセットファイルをCMSへ手動で反映する作業が多く、更新漏れやヒューマンエラーの発生リスク、単純作業による工数圧迫が課題でした。",
		approach: "運用チームが普段使い慣れているGoogleスプレッドシートをデータソースとし、GASとNode.jsを組み合わせてCMS側の設定データやファイルへ自動同期するパイプラインを設計しました。",
		implementation: [
			"GASを用いてスプレッドシート上のページ構成・メタ情報を構造化されたJSON形式へ自動変換・出力",
			"Node.jsスクリプトによりローカル環境からHubSpot CMSへのファイル・テンプレート反映を自動化",
			"Gitによるソースコード・設定ファイルのバージョン管理を導入し、変更履歴の追跡と安全なロールバックを実現",
		],
		result: "手作業による転記ミスをゼロにし、複数ページの同時更新や設定反映にかかる作業時間を大幅に短縮。フロントエンド実装だけでなく開発フロー全体の効率化に貢献しました。",
	},
	{
		slug: "b2b-aeo-structured-data",
		title: "B2BメディアのSEO・AEO/GEO施策および構造化データ実装",
		summary: "検索エンジン・生成AI検索双方での認知向上を目指し、JSON-LD実装・サイト内導線設計・オウンドメディア運用を推進。",
		category: "AEO / Technical SEO",
		role: "Web Improvement / AEO",
		deliverables: "JSON-LD構造化データ / 内部導線改修 / オウンドメディア運用",
		period: "2025.05 - 現在",
		tools: ["JSON-LD", "HTML/CSS", "Search Console", "HubSpot"],
		thumbnail: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=1200&q=80",
		background: "B2BのWebインフラ・セキュリティ領域において、従来の検索エンジン対策（SEO）に加え、生成AIによる検索・回答（AEO/GEO）で自社の技術情報やサービスが正しく参照される状態をつくる必要がありました。",
		approach: "コンテンツの企画・記事制作といったマーケティング視点と、HTMLのセマンティクス・構造化データ実装というフロントエンド技術視点の両面からサイト構造を改善しました。",
		implementation: [
			"FAQ・Article・Organizationなどのスキーマに対応したJSON-LD構造化データをテンプレートへ組み込み",
			"Google Search Consoleのデータを分析し、検索意図に沿ったタイトル・見出し階層・内部リンク導線を再設計",
			"オウンドメディア（note）の立ち上げおよび技術解説記事の企画・執筆・運用フローの構築",
		],
		result: "技術的なマークアップ精度とコンテンツの網羅性を高めたことで、ターゲットキーワードでの検索流入とサイト内の回遊率を着実に向上させました。",
	},
	{
		slug: "client-web-ui-direction",
		title: "クライアントWebサイトのUI/UX設計・実装および進行管理",
		summary: "Figmaを用いたUI設計からレスポンシブ実装、制作チームの進行ディレクション・メンバー育成まで一貫して担当。",
		category: "UI/UX & Direction",
		role: "Technical Director",
		deliverables: "UIデザイン / フロントエンド実装 / 進行管理・育成",
		period: "2023.04 - 現在",
		tools: ["Figma", "HTML/CSS", "JavaScript", "React", "WordPress"],
		thumbnail: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80",
		background: "多様な業種のクライアントWeb制作において、デザインと実装の認識齟齬による手戻りや、チームメンバー間のスキル差による品質のばらつきが課題となっていました。",
		approach: "Figma段階から実装のレスポンシブ挙動やコンポーネント構造を見据えたUI設計を行い、デザイナーと実装者の橋渡し役としてプロジェクト全体の進行と品質基準を統括しました。",
		implementation: [
			"Figmaでのワイヤーフレーム・UIデザイン作成と、実装を意識したスタイルガイド・コンポーネント整理",
			"HTML/CSS/JavaScriptおよびReact・WordPressを用いたフロントエンド実装とブラウザ表示検証",
			"アルバイトリーダーとして制作スケジュールの管理、コード・デザインレビュー、新規メンバーの育成を実施",
		],
		result: "設計から実装までの一貫したディレクションにより手戻りを削減し、チーム全体の制作スピードとアウトプット品質の底上げを達成しました。",
	},
];

const { slug } = Astro.params;
const currentIndex = works.findIndex((w) => w.slug === slug);

if (currentIndex === -1) {
	return Astro.rewrite("/404");
}

const project = works[currentIndex];
const prevProject = works[(currentIndex - 1 + works.length) % works.length];
const nextProject = works[(currentIndex + 1) % works.length];
---

<Base title={`${project.title} | Works`} description={project.summary}>
	<article class="work-detail">
		<header class="detail-hero container">
			<a href="/#works" class="back-link">
				<Icon name="ph:arrow-left" aria-hidden="true" />
				<span>一覧へ戻る</span>
			</a>

			<div class="detail-hero__head">
				<span class="eyebrow">{project.category}</span>
				<h1 class="detail-title">{project.title}</h1>
				<p class="detail-summary">{project.summary}</p>
			</div>

			<dl class="spec-grid">
				<div class="spec-item">
					<dt>担当領域 / Role</dt>
					<dd>{project.role}</dd>
				</div>
				<div class="spec-item">
					<dt>主な成果物 / Deliverables</dt>
					<dd>{project.deliverables}</dd>
				</div>
				<div class="spec-item">
					<dt>期間 / Period</dt>
					<dd>{project.period}</dd>
				</div>
				<div class="spec-item">
					<dt>技術スタック / Tools</dt>
					<dd class="spec-tags">
						{project.tools.map((tool) => (
							<span class="tag">{tool}</span>
						))}
					</dd>
				</div>
			</dl>

			<div class="detail-cover">
				<img
					src={project.thumbnail}
					alt={project.title}
					transition:name={`work-image-${project.slug}`}
				/>
			</div>
		</header>

		<div class="detail-layout container">
			<aside class="detail-toc" aria-label="Table of contents">
				<p class="detail-toc__label">Contents</p>
				<nav class="detail-toc__nav">
					<a href="#background">01. 背景と課題</a>
					<a href="#approach">02. 設計方針・アプローチ</a>
					<a href="#implementation">03. 実装の工夫・技術選定</a>
					<a href="#result">04. 成果と学び</a>
				</nav>
			</aside>

			<div class="detail-body">
				<section id="background" class="detail-section">
					<span class="detail-section__num">01</span>
					<h2>背景と課題</h2>
					<p>{project.background}</p>
				</section>

				<section id="approach" class="detail-section">
					<span class="detail-section__num">02</span>
					<h2>設計方針・アプローチ</h2>
					<p>{project.approach}</p>
				</section>

				<section id="implementation" class="detail-section">
					<span class="detail-section__num">03</span>
					<h2>実装の工夫・技術選定</h2>
					<ul class="detail-list">
						{project.implementation.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>

				<section id="result" class="detail-section">
					<span class="detail-section__num">04</span>
					<h2>成果と学び</h2>
					<p>{project.result}</p>
				</section>
			</div>
		</div>

		<nav class="detail-pager container" aria-label="Project navigation">
			<a href={`/works/${prevProject.slug}`} class="pager-card">
				<span class="pager-card__label">
					<Icon name="ph:arrow-left" aria-hidden="true" />
					PREV PROJECT
				</span>
				<strong class="pager-card__title">{prevProject.title}</strong>
			</a>

			<a href={`/works/${nextProject.slug}`} class="pager-card pager-card--next">
				<span class="pager-card__label">
					NEXT PROJECT
					<Icon name="ph:arrow-right" aria-hidden="true" />
				</span>
				<strong class="pager-card__title">{nextProject.title}</strong>
			</a>
		</nav>
	</article>
</Base>

<style>
	.work-detail {
		padding-top: clamp(40px, 6vw, 72px);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		font-weight: 500;
		color: var(--color-text-secondary);
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-text);
	}

	.detail-hero__head {
		max-width: 840px;
		margin-top: 28px;
	}

	.detail-title {
		margin-top: 12px;
		font-size: clamp(28px, 4.2vw, 52px);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.detail-summary {
		margin-top: 20px;
		font-size: clamp(16px, 1.7vw, 18.5px);
		line-height: 1.75;
		color: var(--color-text-secondary);
	}

	.spec-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
		margin-top: 40px;
		padding: 24px;
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.spec-item dt {
		font-size: 12px;
		font-weight: 600;
		color: var(--color-muted);
	}

	.spec-item dd {
		margin-top: 8px;
		font-size: 14.5px;
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text);
	}

	.spec-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.tag {
		padding: 4px 10px;
		border-radius: var(--radius-sm);
		background: var(--color-sunken);
		font-size: 12px;
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.detail-cover {
		margin-top: 36px;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-media);
		overflow: hidden;
		background: var(--color-sunken);
		box-shadow: var(--shadow-card);
	}

	.detail-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.detail-layout {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: clamp(32px, 6vw, 80px);
		margin-top: clamp(56px, 8vw, 96px);
	}

	.detail-toc {
		position: sticky;
		top: 104px;
		align-self: start;
	}

	.detail-toc__label {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.detail-toc__nav {
		display: grid;
		gap: 12px;
		margin-top: 16px;
		padding-left: 14px;
		border-left: 1px solid var(--color-border);
	}

	.detail-toc__nav a {
		font-size: 13.5px;
		color: var(--color-text-secondary);
		transition: color var(--transition-fast);
	}

	.detail-toc__nav a:hover {
		color: var(--color-text);
	}

	.detail-body {
		display: grid;
		gap: clamp(48px, 6vw, 72px);
		max-width: 720px;
	}

	.detail-section {
		scroll-margin-top: 104px;
	}

	.detail-section__num {
		display: inline-block;
		font-size: 13px;
		font-weight: 600;
		color: var(--color-accent);
	}

	.detail-section h2 {
		margin-top: 6px;
		font-size: clamp(22px, 2.5vw, 28px);
		font-weight: 600;
	}

	.detail-section p {
		margin-top: 16px;
		font-size: 16px;
		line-height: 1.85;
		color: var(--color-text-secondary);
	}

	.detail-list {
		display: grid;
		gap: 14px;
		margin-top: 20px;
	}

	.detail-list li {
		position: relative;
		padding: 16px 20px 16px 36px;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
		font-size: 15px;
		line-height: 1.7;
		color: var(--color-text);
	}

	.detail-list li::before {
		content: "";
		position: absolute;
		top: 25px;
		left: 18px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.detail-pager {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		margin-top: clamp(72px, 10vw, 120px);
		padding-top: 40px;
		border-top: 1px solid var(--color-border);
	}

	.pager-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px;
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		transition:
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.pager-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-card-hover);
	}

	.pager-card--next {
		text-align: right;
		align-items: flex-end;
	}

	.pager-card__label {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--color-muted);
	}

	.pager-card__title {
		font-size: 16.5px;
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-text);
	}

	@media (max-width: 960px) {
		.spec-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.detail-layout {
			grid-template-columns: 1fr;
		}

		.detail-toc {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.spec-grid,
		.detail-pager {
			grid-template-columns: 1fr;
		}
	}
</style>