---
import { getCollection } from "emdash";

const { slug } = Astro.params;

interface WorkDetail {
	slug: string;
	title: string;
	summary: string;
	category: string;
	role: string;
	period: string;
	team: string;
	tools: string[];
	thumbnail: string;
	highlights: { label: string; value: string }[];
	background: string;
	approach: string[];
	result: string;
}

const richWorks: WorkDetail[] = [
	{
		slug: "hubspot-modular-lp",
		title: "HubSpot CMS 汎用LPテンプレート設計",
		summary: "非エンジニアでも管理画面から柔軟にページ構築できる、再利用性と保守性を両立したカスタムモジュール群の設計・実装。",
		category: "CMS / Architecture",
		role: "Frontend Coder / CMS Architect",
		period: "2025.05 - 現在",
		team: "ディレクター1名 / デザイナー1名 / エンジニア1名（自身）",
		tools: ["HubSpot CMS", "HubL", "JavaScript", "fields.json", "CSS"],
		thumbnail: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1400&q=80",
		highlights: [
			{ label: "Focus", value: "非エンジニアの運用負荷軽減" },
			{ label: "Architecture", value: "fields.json による設定の抽象化" },
			{ label: "Impact", value: "LP立ち上げ・修正の属人化を解消" },
		],
		background:
			"新規LPの公開や文言・レイアウト変更のたびにエンジニアがHTML/CSSを直接修正する必要があり、マーケティング施策のスピードとエンジニアの工数双方にボトルネックが発生していました。単発のページ制作ではなく、誰でも安全に組み替えられる仕組み化が求められていました。",
		approach: [
			"よく使われるセクション（FV、特徴一覧、比較表、FAQ、CTAなど）を粒度ごとに分解し、再利用可能なカスタムモジュールとして設計。",
			"fields.json 側で余白・背景トーン・カラム数・表示切替を制御できるようにしつつ、デザインが崩れないよう選択肢を適切に制限（ガードレール設計）。",
			"HubLの条件分岐とループ処理を活用し、入力項目が空の場合は不要なDOMや余白が出力されないクリーンなマークアップを徹底。",
		],
		result:
			"管理画面上でのドラッグ＆ドロップと項目入力だけで、ブランドガイドラインに沿ったLPを短時間で構築できる体制を実現しました。エンジニアは定常的な文言修正から解放され、機能改善や新規開発に集中できるようになりました。",
	},
	{
		slug: "workflow-automation-gas-node",
		title: "Node.js・GASによる制作業務自動化",
		summary: "スプレッドシートの設定データとWebページ情報の自動連携、およびHubSpotへのファイル反映フローを仕組み化。",
		category: "Automation / Tooling",
		role: "Frontend / Tooling Engineer",
		period: "2025.08 - 現在",
		team: "個人主導で提案・設計・実装",
		tools: ["Node.js", "Google Apps Script", "JSON", "Git", "HubSpot CLI"],
		thumbnail: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1400&q=80",
		highlights: [
			{ label: "Trigger", value: "手作業による転記・反映ミスの削減" },
			{ label: "Stack", value: "GAS × Node.js × JSON パイプライン" },
			{ label: "Impact", value: "定型作業の自動化と品質の均一化" },
		],
		background:
			"複数ページにまたがる設定情報の更新や、スプレッドシートで管理しているマスターデータのWeb反映を手作業で行っており、ヒューマンエラーや確認コストが積み上がっていました。",
		approach: [
			"スプレッドシートを「非エンジニアも触れる管理画面」と見立て、GASで入力データを構造化JSONへ自動変換・出力する仕組みを構築。",
			"Node.jsスクリプト側でJSONのバリデーションと差分チェックを行い、問題がなければ所定のディレクトリへ出力・反映するフローを整備。",
			"属人化を防ぐため、エラー時のメッセージ設計と手順書（README）までセットでドキュメント化。",
		],
		result:
			"手作業による転記ミスがゼロになり、更新作業にかかる時間を大幅に短縮できました。日常の「少し面倒な作業」を技術で仕組み化する重要性を実務を通じて体感したプロジェクトです。",
	},
	{
		slug: "b2b-aeo-structured-data",
		title: "B2Bメディア SEO・AEO構造化データ実装",
		summary: "検索エンジンだけでなく生成AI（AEO）からの参照・引用も見据えた、JSON-LD構造化データ設計とテクニカルSEO改善。",
		category: "AEO / Technical SEO",
		role: "Web Improvement / Frontend",
		period: "2025.05 - 現在",
		team: "マーケターと連携して設計・実装",
		tools: ["JSON-LD", "Schema.org", "Search Console", "HubSpot CMS", "HTML"],
		thumbnail: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=1400&q=80",
		highlights: [
			{ label: "Target", value: "検索エンジン + 生成AI（AEO）対応" },
			{ label: "Implementation", value: "動的JSON-LDテンプレート化" },
			{ label: "Verification", value: "Rich Results Test / Search Console" },
		],
		background:
			"B2Bオウンドメディアにおいて、記事コンテンツの質は高いものの、検索エンジンや生成AIがページの意味構造（記事・FAQ・著者・組織情報など）を正確に解釈できるマークアップが不足していました。",
		approach: [
			"Article、FAQPage、BreadcrumbList、Organization などの Schema.org 仕様を整理し、HubSpotのテンプレートから自動でJSON-LDが生成されるよう実装。",
			"見出し階層（h1〜h3）の適正化やセマンティックHTMLの見直しを並行して実施し、クローラビリティとアクセシビリティを底上げ。",
			"Google Search Console とリッチリザルトテストを用いて継続的に検証し、警告・エラーを解消。",
		],
		result:
			"新規記事を公開するだけで自動的に適切な構造化データが出力される基盤を整備。単なる「見た目の実装」にとどまらず、ビジネス成果（流入・認知）に直結するフロントエンド設計の視点を養いました。",
	},
	{
		slug: "client-web-ui-direction",
		title: "クライアントWebサイト UI/UX設計・進行管理",
		summary: "Figmaを用いたUI設計からレスポンシブ実装、制作チームの進行ディレクション・メンバー育成まで一貫して担当。",
		category: "UI/UX & Direction",
		role: "Technical Director / Frontend",
		period: "2023.04 - 現在",
		team: "クライアント / 制作メンバー複数名",
		tools: ["Figma", "HTML / CSS", "JavaScript", "React", "Git"],
		thumbnail: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1400&q=80",
		highlights: [
			{ label: "Scope", value: "要件整理 → UI設計 → 実装 → 進行管理" },
			{ label: "Strength", value: "デザイン意図と実装コストの橋渡し" },
			{ label: "Team", value: "コードレビュー・メンバー育成を担当" },
		],
		background:
			"クライアントの要望をそのまま画面に落とし込むだけでは使いにくくなったり、実装フェーズで手戻りが発生したりする課題がありました。設計と実装の両面を理解した進行役が必要でした。",
		approach: [
			"Figmaでコンポーネント設計とレスポンシブの挙動を事前に定義し、実装時の認識ズレを最小化。",
			"実装フェーズではセマンティックなHTMLと保守しやすいCSS設計を心がけ、アニメーションやマイクロインタラクションで操作感を向上。",
			"他メンバーのコードレビューやタスク切り出しを行い、チーム全体で品質を担保する進行管理を実践。",
		],
		result:
			"クライアントの意図を汲み取りながら、技術的な実現可能性とスケジュールを両立させて納品まで完走する力を培いました。デザインとエンジニアリングの橋渡しができる点が自身の強みになっています。",
	},
];

let work = richWorks.find((w) => w.slug === slug) || richWorks[0];

try {
	const rawWorks = await getCollection("works");
	const found = Array.isArray(rawWorks)
		? rawWorks.find((e: any) => String(e?.slug ?? e?.data?.slug) === slug)
		: null;
	if (found) {
		const d = found.data ?? found;
		const cmsTools = Array.isArray(d.tools)
			? d.tools
			: typeof d.tools === "string"
				? d.tools.split(",").map((t: string) => t.trim()).filter(Boolean)
				: work.tools;

		work = {
			...work,
			title: d.title || work.title,
			summary: d.summary || work.summary,
			category: d.category || work.category,
			role: d.role || work.role,
			period: d.period || work.period,
			tools: cmsTools.length > 0 ? cmsTools : work.tools,
			thumbnail:
				typeof d.thumbnail === "string"
					? d.thumbnail
					: d.thumbnail?.url || d.thumbnail?.$media?.url || work.thumbnail,
			background: d.background || work.background,
			result: d.result || work.result,
		};
	}
} catch {}

const currentIndex = richWorks.findIndex((w) => w.slug === work.slug);
const nextWork = richWorks[(currentIndex + 1) % richWorks.length];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{work.title} | 齋藤 条太郎</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="ambient" aria-hidden="true">
			<div class="ambient__blob"></div>
			<div class="ambient__grain"></div>
		</div>

		<header class="site-header">
			<a href="/" class="brand">齋藤 条太郎</a>
			<nav class="site-nav">
				<a href="/">01 Index</a>
				<a href="/about">02 About</a>
			</nav>
		</header>

		<main class="wrap">
			<a href="/" class="crumb">← Back to Works</a>

			<div class="meta-bar">
				<span>{work.category}</span>
				<span>/</span>
				<span>{work.period}</span>
			</div>

			<h1 class="title">{work.title}</h1>
			<p class="summary">{work.summary}</p>

			<div class="spec-grid">
				<div class="spec-item">
					<span class="spec-label">Role</span>
					<span class="spec-val">{work.role}</span>
				</div>
				<div class="spec-item">
					<span class="spec-label">Team</span>
					<span class="spec-val">{work.team}</span>
				</div>
				<div class="spec-item">
					<span class="spec-label">Tech Stack</span>
					<ul class="tags">
						{work.tools.map((t) => <li>{t}</li>)}
					</ul>
				</div>
			</div>

			<div class="hero-img">
				<img src={work.thumbnail} alt={work.title} />
			</div>

			<!-- ハイライト指標 -->
			<div class="highlights">
				{
					work.highlights.map((h) => (
						<div class="hl-card">
							<span class="hl-label">{h.label}</span>
							<p class="hl-val">{h.value}</p>
						</div>
					))
				}
			</div>

			<!-- 本文セクション -->
			<div class="sections">
				<section class="detail-sec">
					<span class="sec-num">01 / Context &amp; Challenge</span>
					<h2>背景と課題</h2>
					<p>{work.background}</p>
				</section>

				<section class="detail-sec">
					<span class="sec-num">02 / Architecture &amp; Approach</span>
					<h2>設計方針と技術的な工夫</h2>
					<ul class="approach-list">
						{work.approach.map((item) => <li>{item}</li>)}
					</ul>
				</section>

				<section class="detail-sec">
					<span class="sec-num">03 / Impact &amp; Takeaways</span>
					<h2>成果と学び</h2>
					<p>{work.result}</p>
				</section>
			</div>

			<!-- 次の実績への導線 -->
			<a href={`/works/${nextWork.slug}`} class="next-card">
				<div>
					<span class="next-kicker">Next Case Study</span>
					<h3>{nextWork.title}</h3>
				</div>
				<span class="next-arrow">→</span>
			</a>

			<footer class="foot">
				<a href="/" class="back-link">← Indexへ戻る</a>
				<span>© 2026 齋藤 条太郎</span>
			</footer>
		</main>

		<style>
			:root {
				--bg: #111112;
				--surface: rgba(255, 255, 255, 0.04);
				--ink: #f0efe9;
				--ink-2: rgba(240, 239, 233, 0.74);
				--muted: rgba(240, 239, 233, 0.44);
				--line: rgba(240, 239, 233, 0.14);
				--ease: cubic-bezier(0.16, 1, 0.3, 1);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: "Inter", "Noto Sans JP", sans-serif;
				-webkit-font-smoothing: antialiased;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.ambient {
				position: fixed;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				background: radial-gradient(circle at 20% 80%, #26272b 0%, #121214 55%, #0c0c0d 100%);
			}

			.ambient__blob {
				position: absolute;
				width: 55vw;
				height: 55vw;
				right: -15vw;
				top: -15vw;
				border-radius: 50%;
				filter: blur(120px);
				background: radial-gradient(circle, rgba(160, 175, 200, 0.16), transparent 70%);
			}

			.ambient__grain {
				position: absolute;
				inset: 0;
				opacity: 0.08;
				background-image: radial-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 0);
				background-size: 3px 3px;
			}

			.site-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 20px clamp(20px, 4vw, 48px);
				border-bottom: 1px solid var(--line);
				background: rgba(17, 17, 18, 0.65);
				backdrop-filter: blur(12px);
			}

			.brand {
				font-family: "Noto Serif JP", serif;
				font-size: 15px;
				letter-spacing: 0.12em;
			}

			.site-nav {
				display: flex;
				gap: 24px;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--ink-2);
			}

			.wrap {
				position: relative;
				z-index: 2;
				width: min(920px, calc(100% - clamp(32px, 6vw, 96px)));
				margin-inline: auto;
				padding: 124px 0 88px;
			}

			.crumb {
				display: inline-block;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
				margin-bottom: 28px;
			}

			.crumb:hover {
				color: var(--ink);
			}

			.meta-bar {
				display: flex;
				gap: 10px;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
			}

			.title {
				margin: 14px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: clamp(26px, 4vw, 44px);
				font-weight: 500;
				line-height: 1.35;
				text-wrap: balance;
			}

			.summary {
				margin: 18px 0 0;
				font-size: 15.5px;
				line-height: 1.9;
				color: var(--ink-2);
			}

			.spec-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 20px;
				margin-top: 32px;
				padding-block: 22px;
				border-top: 1px solid var(--line);
				border-bottom: 1px solid var(--line);
			}

			.spec-label {
				display: block;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
				margin-bottom: 8px;
			}

			.spec-val {
				font-size: 13.5px;
				line-height: 1.6;
				color: var(--ink);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.tags li {
				padding: 3px 8px;
				border-radius: 5px;
				border: 1px solid var(--line);
				background: var(--surface);
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--ink-2);
			}

			.hero-img {
				margin-top: 36px;
				aspect-ratio: 16 / 9;
				border-radius: 16px;
				overflow: hidden;
				border: 1px solid var(--line);
			}

			.hero-img img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.highlights {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 16px;
				margin-top: 24px;
			}

			.hl-card {
				padding: 20px;
				border-radius: 14px;
				background: var(--surface);
				border: 1px solid var(--line);
			}

			.hl-label {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
			}

			.hl-val {
				margin: 8px 0 0;
				font-size: 14px;
				font-weight: 500;
				line-height: 1.5;
			}

			.sections {
				margin-top: 64px;
				display: flex;
				flex-direction: column;
				gap: 52px;
			}

			.detail-sec {
				padding-top: 28px;
				border-top: 1px solid var(--line);
			}

			.sec-num {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
			}

			.detail-sec h2 {
				margin: 8px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: 22px;
				font-weight: 500;
			}

			.detail-sec p {
				margin: 16px 0 0;
				font-size: 15px;
				line-height: 1.95;
				color: var(--ink-2);
			}

			.approach-list {
				margin: 18px 0 0;
				padding-left: 20px;
				display: flex;
				flex-direction: column;
				gap: 14px;
				font-size: 15px;
				line-height: 1.85;
				color: var(--ink-2);
			}

			.next-card {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 20px;
				margin-top: 72px;
				padding: 28px 32px;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid var(--line);
				transition:
					transform 280ms var(--ease),
					border-color 280ms var(--ease);
			}

			.next-card:hover {
				transform: translateY(-3px);
				border-color: rgba(240, 239, 233, 0.35);
			}

			.next-kicker {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
			}

			.next-card h3 {
				margin: 8px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: 20px;
				font-weight: 500;
			}

			.next-arrow {
				font-size: 22px;
				color: var(--ink-2);
			}

			.foot {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 64px;
				padding-top: 20px;
				border-top: 1px solid var(--line);
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
			}

			.back-link {
				color: var(--ink);
				border-bottom: 1px solid var(--ink);
				padding-bottom: 2px;
			}

			@media (max-width: 768px) {
				.spec-grid,
				.highlights {
					grid-template-columns: 1fr;
				}
