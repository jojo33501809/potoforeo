				background: var(--navy);
				transform-origin: left center;
				transform: scaleX(0);
			}

			.hud-next {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				border: 1px solid rgba(30, 58, 138, 0.25);
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.88);
				color: var(--navy);
				padding: 6px 14px;
				font: inherit;
				cursor: pointer;
				box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
				transition:
					background-color 260ms var(--ease),
					transform 260ms var(--ease);
			}

			.hud-next:hover {
				background: var(--navy);
				color: #ffffff;
				transform: translateY(-1px);
			}

			.scroll-track {
				position: relative;
				z-index: 10;
				height: 680vh;
			}

			.sticky-stage {
				position: sticky;
				top: 0;
				height: 100svh;
				overflow: hidden;
			}

			.bg-marquee {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 84px;
				z-index: 1;
				overflow: hidden;
				pointer-events: none;
				opacity: 0;
			}

			.bg-marquee__track {
				display: flex;
				gap: 28px;
				width: max-content;
				font-family: "Cormorant Garamond", serif;
				font-size: clamp(28px, 4vw, 52px);
				color: rgba(30, 58, 138, 0.08);
				letter-spacing: 0.06em;
				animation: bg-marquee-run 55s linear infinite;
			}

			@keyframes bg-marquee-run {
				from {
					transform: translateX(0);
				}
				to {
					transform: translateX(-50%);
				}
			}

			.section-banner {
				position: absolute;
				top: 50%;
				left: 50%;
				z-index: 5;
				margin: 0;
				font-family: "Cormorant Garamond", serif;
				font-size: clamp(44px, 6.2vw, 88px);
				font-weight: 500;
				color: var(--navy);
				white-space: nowrap;
				opacity: 0;
				pointer-events: none;
				will-change: transform, opacity;
			}

			.works-stage {
				position: absolute;
				inset: 0;
				z-index: 5;
				opacity: 0;
				pointer-events: none;
			}

			.works-viewport {
				position: absolute;
				top: 50%;
				left: 50%;
				width: min(1080px, calc(100% - clamp(36px, 8vw, 112px)));
				height: 64vh;
				transform: translate(-50%, -50%);
			}

			.work-slide {
				position: absolute;
				inset: 0;
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
				align-items: center;
				gap: clamp(28px, 4.5vw, 60px);
				will-change: transform, opacity;
			}

			.work-slide__media {
				position: relative;
				display: block;
				aspect-ratio: 16 / 10;
				border-radius: 14px;
				overflow: hidden;
				border: 1px solid var(--line);
				background: #e2e8f0;
				box-shadow: 0 20px 44px rgba(15, 23, 42, 0.08);
			}

			.work-slide__media img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 900ms var(--ease);
			}

			.work-slide__media:hover img {
				transform: scale(1.03);
			}

			.work-slide__num {
				position: absolute;
				top: 14px;
				left: 14px;
				padding: 4px 10px;
				border-radius: 999px;
				background: rgba(15, 23, 42, 0.84);
				color: #ffffff;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
			}

			.work-slide__meta {
				display: flex;
				gap: 10px;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--navy);
			}

			.work-slide__title {
				min-height: 1.4em;
				margin: 14px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: clamp(20px, 2.3vw, 30px);
				font-weight: 500;
				line-height: 1.4;
				color: var(--ink);
				text-wrap: balance;
			}

			.work-slide__summary {
				margin: 14px 0 0;
				font-size: 14px;
				line-height: 1.8;
				color: var(--ink-2);
			}

			.work-slide__tags {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin: 18px 0 0;
				padding: 0;
				list-style: none;
			}

			.work-slide__tags li {
				padding: 4px 10px;
				border-radius: 6px;
				border: 1px solid rgba(30, 58, 138, 0.16);
				background: var(--navy-soft);
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--navy);
			}

			.work-slide__cta {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				margin-top: 24px;
				padding-bottom: 4px;
				border-bottom: 1px solid var(--navy);
				color: var(--navy);
				font-weight: 500;
				font-size: 13px;
			}

			.cap-panel {
				position: absolute;
				top: 50%;
				left: 50%;
				z-index: 5;
				width: min(1080px, calc(100% - clamp(36px, 8vw, 112px)));
				opacity: 0;
				pointer-events: none;
				will-change: transform, opacity;
			}

			.cap-head {
				margin-bottom: 28px;
			}

			.cap-title {
				min-height: 1.3em;
				margin: 10px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: clamp(24px, 3vw, 36px);
				font-weight: 500;
				color: var(--ink);
			}

			.cap-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 20px;
			}

			.cap-card {
				padding: 26px;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid var(--line);
				box-shadow: 0 12px 32px rgba(15, 23, 42, 0.04);
				backdrop-filter: blur(8px);
			}

			.cap-card__top {
				display: flex;
				justify-content: space-between;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--navy);
			}

			.cap-jp {
				margin: 14px 0 0;
				font-size: 16px;
				font-weight: 500;
				line-height: 1.45;
				color: var(--ink);
			}

			.cap-desc {
				margin: 10px 0 0;
				font-size: 13px;
				line-height: 1.8;
				color: var(--ink-2);
			}

			.cap-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin: 18px 0 0;
				padding: 0;
				list-style: none;
			}

			.cap-tags li {
				padding: 3px 8px;
				border-radius: 5px;
				border: 1px solid rgba(30, 58, 138, 0.14);
				background: var(--navy-soft);
				font-family: "JetBrains Mono", monospace;
				font-size: 10.5px;
				color: var(--navy);
			}

			.overlay-panel {
				position: absolute;
				top: 50%;
				left: 50%;
				z-index: 5;
				width: min(740px, calc(100% - 48px));
				text-align: center;
				opacity: 0;
				pointer-events: none;
				will-change: transform, opacity;
			}

			.panel-kicker {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				letter-spacing: 0.12em;
				color: var(--navy);
				text-transform: uppercase;
			}

			.panel-title {
				min-height: 1.35em;
				margin: 14px 0 0;
				font-family: "Noto Serif JP", "Cormorant Garamond", serif;
				font-size: clamp(26px, 3.8vw, 44px);
				font-weight: 500;
				line-height: 1.35;
				color: var(--ink);
				text-wrap: balance;
			}

			.panel-desc {
				max-width: 56ch;
				margin: 20px auto 0;
				font-size: 14.5px;
				line-height: 1.9;
				color: var(--ink-2);
			}

			.panel-actions {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 14px;
				margin-top: 30px;
			}

			.panel-btn {
				display: inline-flex;
				align-items: center;
				padding: 11px 24px;
				border-radius: 999px;
				border: 0;
				background: var(--navy);
				color: #ffffff;
				font-family: inherit;
				font-size: 13px;
				font-weight: 500;
				cursor: pointer;
				box-shadow: 0 8px 20px rgba(30, 58, 138, 0.2);
				transition:
					transform 300ms var(--ease),
					background-color 300ms var(--ease);
			}

			.panel-btn:hover {
				transform: translateY(-2px);
				background: #172554;
			}

			.panel-btn--ghost {
				background: #ffffff;
				color: var(--navy);
				border: 1px solid rgba(30, 58, 138, 0.25);
				box-shadow: none;
			}

			.panel-btn--ghost:hover {
				background: var(--navy-soft);
			}

			@media (max-width: 900px) {
				.site-header__left,
				.tone-switch,
				.ring-cursor {
					display: none;
				}
				.site-header {
					justify-content: center;
				}
				.work-slide,
				.cap-grid {
					grid-template-columns: 1fr;
					gap: 14px;
				}
				.work-slide__summary,
				.cap-desc {
					display: none;
				}
			}
		</style>
	</body>
</html>