---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";

interface ProjectItem {
	slug: string;
	title: string;
	summary: string;
	category: string;
	role: string;
	period: string;
	tools: string[];
	featured: boolean;
	thumbnail: string;
}

const projects: ProjectItem[] = [
	{
		slug: "hubspot-modular-lp",
		title: "HubSpot CMS 汎用LPテンプレート・カスタムモジュール開発",
		summary: "非エンジニアでも管理画面から柔軟にページ構築できる再利用可能なモジュール群。",
		category: "CMS / Architecture",
		role: "Frontend Coder",
		period: "2025.05 - 現在",
		tools: ["HubSpot CMS", "HubL", "JavaScript", "fields.json"],
		featured: true,
		thumbnail: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80",
	},
	{
		slug: "workflow-automation-gas-node",
		title: "Node.js・GASを活用した制作業務効率化ツール",
		summary: "スプレッドシートの設定データとWebページ情報の自動連携やHubSpotファイル反映フロー。",
		category: "Automation",
		role: "Frontend / Tooling",
		period: "2025.08 - 現在",
		tools: ["Node.js", "GAS", "JSON", "Git"],
		featured: true,
		thumbnail: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1200&q=80",
	},
	{
		slug: "b2b-aeo-structured-data",
		title: "B2BメディアのSEO・AEO施策および構造化データ実装",
		summary: "検索エンジン・生成AI双方での認知向上を目指したJSON-LD実装・オウンドメディア運用。",
		category: "AEO / Technical SEO",
		role: "Web Improvement",
		period: "2025.05 - 現在",
		tools: ["JSON-LD", "Search Console", "HubSpot"],
		featured: false,
		thumbnail: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=1200&q=80",
	},
	{
		slug: "client-web-ui-direction",
		title: "クライアントWebサイトのUI/UX設計および進行管理",
		summary: "Figmaを用いたUI設計からレスポンシブ実装、制作チームの進行ディレクション・育成まで。",
		category: "UI/UX & Direction",
		role: "Technical Director",
		period: "2023.04 - 現在",
		tools: ["Figma", "HTML/CSS", "JavaScript", "React"],
		featured: false,
		thumbnail: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80",
	},
];

const featuredProjects = projects.filter((p) => p.featured);
const categories = ["All", ...new Set(projects.map((p) => p.category))];
---

<Base title="齋藤 条太郎 | Frontend Engineer Portfolio">
	<section class="hero container">
		<div class="hero__inner rise">
			<p class="hero__eyebrow">齋藤 条太郎 / Frontend Engineer（28卒 エンジニア志望）</p>
			<h1 class="hero__title">
				運用しやすい仕組みと、<br />
				心地よいUI体験を実装する。
			</h1>
			<p class="hero__lead">
				長期インターン・実務でのフロントエンド開発やCMSモジュール設計、ディレクション経験を軸に、設計意図を汲み取りプロダクトの価値を高めるエンジニアを目指しています。
			</p>
			<div class="hero__actions">
				<a href="#works" class="btn btn-lg">
					制作実績を見る
					<Icon name="ph:arrow-down-right" class="arrow" aria-hidden="true" />
				</a>
				<a href="/about" class="btn btn-lg btn-secondary">
					経歴・スキル詳細（About）
				</a>
			</div>
		</div>
	</section>

	<section id="works" class="section container">
		<div class="section-head">
			<div>
				<span class="eyebrow">Selected Works</span>
				<h2 class="section-title">ピックアップ実績</h2>
			</div>
			<p class="section-note">実務で設計・仕組み化から実装まで一貫して担当した代表プロジェクト</p>
		</div>

		<div class="featured-grid">
			{
				featuredProjects.map((project, index) => (
					<a
						href={`/works/${project.slug}`}
						class="work-card rise"
						style={`--rise-index: ${index}`}
					>
						<div class="work-card__media">
							<img
								src={project.thumbnail}
								alt={project.title}
								loading="eager"
								transition:name={`work-image-${project.slug}`}
							/>
							<span class="work-card__badge">{project.role}</span>
						</div>
						<div class="work-card__body">
							<div class="work-card__meta">
								<span>{project.category}</span>
								<span>{project.period}</span>
							</div>
							<div class="work-card__title-row">
								<h3 class="work-card__title">{project.title}</h3>
								<span class="work-card__icon" aria-hidden="true">
									<Icon name="ph:arrow-up-right" />
								</span>
							</div>
							<p class="work-card__summary">{project.summary}</p>
							<ul class="tag-list">
								{project.tools.map((tool) => (
									<li class="tag">{tool}</li>
								))}
							</ul>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section class="section container">
		<div class="archive-head">
			<div>
				<span class="eyebrow">All Archive</span>
				<h2 class="section-title">プロジェクト一覧</h2>
			</div>
			<div class="archive-controls">
				<div class="filter-bar" role="tablist" aria-label="Category filter">
					{
						categories.map((category, idx) => (
							<button
								type="button"
								class="filter-btn"
								data-filter={category}
								data-active={idx === 0 ? "true" : "false"}
							>
								{category}
							</button>
						))
					}
				</div>
				<div class="view-toggle" role="group" aria-label="View mode">
					<button type="button" class="view-btn" data-view="list" data-active="true" aria-label="List view">
						<Icon name="ph:list-bullets" aria-hidden="true" />
					</button>
					<button type="button" class="view-btn" data-view="grid" data-active="false" aria-label="Grid view">
						<Icon name="ph:squares-four" aria-hidden="true" />
					</button>
				</div>
			</div>
		</div>

		<div class="archive-container" data-view="list">
			{
				projects.map((project) => (
					<a
						href={`/works/${project.slug}`}
						class="archive-item"
						data-category={project.category}
						data-image={project.thumbnail}
					>
						<div class="archive-item__media">
							<img src={project.thumbnail} alt={project.title} loading="lazy" />
						</div>
						<div class="archive-item__body">
							<div class="archive-item__content">
								<h3 class="archive-item__title">{project.title}</h3>
								<p class="archive-item__summary">{project.summary}</p>
							</div>
							<div class="archive-item__meta">
								<span class="archive-item__role">{project.role}</span>
								<div class="archive-item__tags">
									{project.tools.slice(0, 3).map((tool) => (
										<span class="tag">{tool}</span>
									))}
								</div>
							</div>
							<div class="archive-item__action">
								<span class="archive-item__icon" aria-hidden="true">
									<Icon name="ph:arrow-up-right" />
								</span>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section class="section container">
		<div class="stance-box">
			<div class="stance-box__head">
				<span class="eyebrow">Profile & Vision</span>
				<h2 class="section-title">開発スタイルと今後の展望</h2>
			</div>

			<div class="stance-grid">
				<div class="stance-card">
					<span class="stance-card__num">01</span>
					<h3>再利用性と運用性を重視した設計</h3>
					<p>個別ページの実装にとどまらず、汎用モジュール設計や管理画面のUX改善を通じて、チーム全体が迷わず運用できる仕組みづくりを得意としています。</p>
				</div>
				<div class="stance-card">
					<span class="stance-card__num">02</span>
					<h3>生成AIを活用した高速な検証サイクル</h3>
					<p>未知の技術や不具合に対しても、生成AIと公式ドキュメントを併用して原因分析・実装・動作検証を高速に回し、自走して形にする力を培ってきました。</p>
				</div>
				<div class="stance-card">
					<span class="stance-card__num">03</span>
					<h3>プロダクト全体へ領域を広げる展望</h3>
					<p>フロントエンド・UI設計を起点に、プログラミングの基礎と開発技術をさらに深め、Webサービスの設計・開発・改善まで主体的に担うエンジニアを目指します。</p>
				</div>
			</div>

			<div class="stance-box__footer">
				<a href="/about" class="btn btn-lg">
					職務経歴・スキル一覧を見る
					<Icon name="ph:arrow-right" class="arrow" aria-hidden="true" />
				</a>
			</div>
		</div>
	</section>

	<div class="cursor-preview" aria-hidden="true" data-show="false">
		<img src="" alt="" />
	</div>
</Base>

<script>
	document.addEventListener("astro:page-load", () => {
		const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
		const items = document.querySelectorAll<HTMLElement>(".archive-item");

		filterBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const selected = btn.dataset.filter;
				filterBtns.forEach((b) => {
					b.dataset.active = b === btn ? "true" : "false";
				});
				items.forEach((item) => {
					const match = selected === "All" || item.dataset.category === selected;
					item.hidden = !match;
				});
			});
		});

		const viewBtns = document.querySelectorAll<HTMLButtonElement>(".view-btn");
		const container = document.querySelector<HTMLElement>(".archive-container");

		viewBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const view = btn.dataset.view;
				if (!view || !container) return;
				viewBtns.forEach((b) => {
					b.dataset.active = b === btn ? "true" : "false";
				});
				container.dataset.view = view;
			});
		});

		const preview = document.querySelector<HTMLElement>(".cursor-preview");
		const previewImg = preview?.querySelector("img");

		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let isHovering = false;
		let isFirstMove = true;
		let rafId = 0;

		const lerp = (start: number, end: number, factor: number): number =>
			start + (end - start) * factor;

		const handleMouseMove = (e: MouseEvent) => {
			targetX = e.clientX;
			targetY = e.clientY;

			if (isFirstMove) {
				currentX = targetX;
				currentY = targetY;
				isFirstMove = false;
			}
		};

		document.addEventListener("mousemove", handleMouseMove);

		const animate = () => {
			if (preview) {
				currentX = lerp(currentX, targetX, 0.12);
				currentY = lerp(currentY, targetY, 0.12);

				const deltaX = targetX - currentX;
				const skewX = Math.max(Math.min(deltaX * 0.04, 15), -15);
				const scale = isHovering ? 1 : 0.9;

				preview.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%) skewX(${skewX}deg) scale(${scale})`;
			}
			rafId = requestAnimationFrame(animate);
		};

		animate();

		items.forEach((item) => {
			const src = item.dataset.image;
			if (src) {
				const img = new Image();
				img.src = src;
			}

			item.addEventListener("mouseenter", () => {
				if (container?.dataset.view !== "list" || window.innerWidth < 960) return;
				if (preview && previewImg && src) {
					previewImg.src = src;
					preview.dataset.show = "true";
					isHovering = true;
				}
			});

			item.addEventListener("mouseleave", () => {
				if (preview) {
					preview.dataset.show = "false";
					isHovering = false;
				}
			});
		});

		document.addEventListener(
			"astro:before-swap",
			() => {
				cancelAnimationFrame(rafId);
				document.removeEventListener("mousemove", handleMouseMove);
			},
			{ once: true },
		);
	});
	
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15 
  };

  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
       
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target); 
      }
    });
  }, observerOptions);

  document.querySelectorAll('.rise, .work-card, .stance-card').forEach((el, index) => {
    el.classList.add('js-observe'); // 初期状態を隠すためのクラスを付与
    observer.observe(el);
  });
</script>

<style>
	.hero {
		padding-block: clamp(72px, 12vw, 148px) clamp(48px, 8vw, 96px);
	}

	.hero__inner {
		max-width: 860px;
	}

	.hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		border-radius: var(--radius-full);
		background: var(--color-sunken);
		border: 1px solid var(--color-border);
		font-size: 13px;
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.hero__title {
		margin-top: 24px;
		font-size: clamp(36px, 5.6vw, 72px);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.hero__lead {
		max-width: 62ch;
		margin-top: 24px;
		font-size: clamp(16px, 1.8vw, 19px);
		line-height: 1.75;
		color: var(--color-text-secondary);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 36px;
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: clamp(32px, 4vw, 48px);
	}

	.section-title {
		margin-top: 8px;
		font-size: clamp(28px, 3.4vw, 42px);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.section-note {
		font-size: 14.5px;
		color: var(--color-text-secondary);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(24px, 3vw, 36px);
	}

	.work-card {
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		transition:
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.work-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card-hover);
	}

	.work-card__media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--color-sunken);
	}

	.work-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-slow);
	}

	.work-card:hover .work-card__media img {
		transform: scale(1.04);
	}

	.work-card__badge {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 6px 12px;
		border-radius: var(--radius-full);
		background: var(--chip-bg);
		color: var(--chip-text);
		font-size: 12px;
		font-weight: 500;
		backdrop-filter: blur(12px);
	}

	.work-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: clamp(20px, 2.5vw, 28px);
	}

	.work-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 12.5px;
		color: var(--color-muted);
	}

	.work-card__title-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		margin-top: 10px;
	}

	.work-card__title {
		font-size: clamp(18px, 1.8vw, 22px);
		font-weight: 600;
		line-height: 1.35;
	}

	.work-card__icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-sunken);
		color: var(--color-text);
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.work-card:hover .work-card__icon {
		background: var(--color-brand);
		color: var(--color-on-brand);
		transform: translate(2px, -2px);
	}

	.work-card__summary {
		margin-top: 10px;
		font-size: 14.5px;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: auto;
		padding-top: 18px;
	}

	.tag {
		padding: 4px 10px;
		border-radius: var(--radius-sm);
		background: var(--color-sunken);
		font-size: 12px;
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.archive-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: clamp(28px, 4vw, 40px);
	}

	.archive-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
	}

	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.filter-btn {
		padding: 8px 16px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface);
		color: var(--color-text-secondary);
		font-family: inherit;
		font-size: 13.5px;
		font-weight: 500;
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.filter-btn:hover {
		border-color: var(--color-border-strong);
		color: var(--color-text);
	}

	.filter-btn[data-active="true"] {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: var(--color-on-brand);
	}

	.view-toggle {
		display: flex;
		padding: 4px;
		border-radius: var(--radius-full);
		background: var(--color-sunken);
	}

	.view-btn {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--color-text-secondary);
		font-size: 18px;
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.view-btn[data-active="true"] {
		background: var(--color-surface);
		color: var(--color-text);
		box-shadow: var(--shadow-sm);
	}

	.archive-container[data-view] .archive-item[hidden] {
		display: none;
	}

	.archive-container[data-view="grid"] {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.archive-container[data-view="grid"] .archive-item {
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		transition:
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.archive-container[data-view="grid"] .archive-item:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card-hover);
	}

	.archive-container[data-view="grid"] .archive-item__media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-sunken);
	}

	.archive-container[data-view="grid"] .archive-item__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.archive-container[data-view="grid"] .archive-item__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 20px;
	}

	.archive-container[data-view="grid"] .archive-item__content {
		order: 2;
		margin-top: 10px;
	}

	.archive-container[data-view="grid"] .archive-item__meta {
		order: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 12px;
		color: var(--color-muted);
	}

	.archive-container[data-view="grid"] .archive-item__title {
		font-size: 18px;
		font-weight: 600;
		line-height: 1.35;
	}

	.archive-container[data-view="grid"] .archive-item__summary {
