---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";

const skillGroups = [
	{
		category: "Frontend & UI",
		items: [
			{ name: "HTML / CSS", detail: "セマンティック設計、レスポンシブ実装、CSS設計" },
			{ name: "JavaScript / TypeScript", detail: "UIインタラクション実装、イベント制御、デバッグ" },
			{ name: "React / Astro", detail: "コンポーネント設計、テンプレート構築" },
			{ name: "Figma", detail: "UI/UX設計、デザインカンプからの忠実な実装" },
		],
	},
	{
		category: "CMS & Automation",
		items: [
			{ name: "HubSpot CMS (HubL / fields.json)", detail: "汎用LPテンプレート・カスタムモジュール開発" },
			{ name: "WordPress", detail: "テーマカスタマイズ・運用改善" },
			{ name: "Node.js / GAS", detail: "スプレッドシート連携・ファイル反映の業務自動化" },
			{ name: "Git", detail: "ソースコード管理・チーム開発フロー" },
		],
	},
	{
		category: "Technical SEO / AEO & AI",
		items: [
			{ name: "SEO / AEO / GEO施策", detail: "JSON-LD構造化データ実装、Search Console分析" },
			{ name: "生成AI活用開発", detail: "実装調査、コード生成、エラー原因分析、検証サイクル" },
		],
	},
];

const experiences = [
	{
		period: "2025年5月 — 現在",
		company: "アクセリア株式会社",
		role: "フロントエンドコーダー（インターン・アルバイト）",
		highlights: [
			"HubSpot CMSを用いたLP・Webページ構築、再利用可能な汎用カスタムモジュールの開発",
			"fields.jsonによる管理画面UIの操作性改善および非エンジニア向け運用フロー整備",
			"Node.js・GASを活用したデータ連携および制作業務の効率化",
			"B2B Webインフラ・セキュリティ領域におけるSEO / AEO / GEO施策、JSON-LD構造化データ実装",
		],
	},
	{
		period: "2023年4月 — 現在",
		company: "クリエイティブインサイト合同会社",
		role: "テクニカルディレクター（アルバイトリーダー）",
		highlights: [
			"WebサイトのUI/UX設計およびフロントエンドコーディング",
			"制作プロジェクトの進行ディレクション・品質管理",
			"制作チームのマネジメントおよび新規メンバーの育成サポート",
		],
	},
];
---

<Base title="About | 齋藤 条太郎">
	<section class="about-hero container">
		<div class="rise">
			<span class="eyebrow">About Me</span>
			<h1 class="about-title">齋藤 条太郎</h1>
			<p class="about-subtitle">
				サイバー大学 在学中（2028年3月卒業予定） / Frontend Engineer 志望
			</p>
			<p class="about-lead">
				「見た目の実装」だけでなく「運用しやすさ」と「事業成果につながる導線設計」まで踏み込むフロントエンド開発を強みとしています。2社での長期実務を通じて培った技術力・ディレクション力・AI活用力を武器に、変化の速い環境で主体的にプロダクトを成長させるエンジニアを目指しています。
			</p>
		</div>
	</section>

	<section class="section container">
		<div class="bento-grid">
			<article class="bento-card bento-card--wide">
				<span class="bento-card__label">01. Career Experience / 実務経歴</span>
				<h2 class="bento-card__title">フロントエンド実装とディレクションの両輪での実務経験</h2>
				<div class="timeline">
					{
						experiences.map((exp) => (
							<div class="timeline-item">
								<div class="timeline-item__head">
									<span class="timeline-item__period">{exp.period}</span>
									<h3 class="timeline-item__company">{exp.company}</h3>
									<p class="timeline-item__role">{exp.role}</p>
								</div>
								<ul class="timeline-item__list">
									{exp.highlights.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</article>

			<article class="bento-card">
				<span class="bento-card__label">02. Work Style / 仕事のスタイル</span>
				<h2 class="bento-card__title">自走する検証サイクルと仕組み化</h2>
				<div class="style-list">
					<div class="style-item">
						<h3>再現性のある設計</h3>
						<p>
							単発の実装で終わらせず、汎用モジュール化やヘルプテキスト整備など「誰が触っても崩れない設計」を心がけています。
						</p>
					</div>
					<div class="style-item">
						<h3>AI × 公式ドキュメントでの高速学習</h3>
						<p>
							未経験の技術領域でも、生成AIで仮説検証を行いながら一次情報（公式ドキュメント）で裏付けを取り、実環境で確実に形にします。
						</p>
					</div>
					<div class="style-item">
						<h3>技術とマーケティングの架け橋</h3>
						<p>
							テクニカルディレクターおよびAEO/SEO施策の経験から、エンジニア視点とビジネス・ユーザー視点の双方で会話できます。
						</p>
					</div>
				</div>
			</article>

			<article class="bento-card bento-card--accent">
				<span class="bento-card__label">03. Future Vision / 将来のビジョン</span>
				<h2 class="bento-card__title">Webサービスの設計・開発・改善を一貫して担うエンジニアへ</h2>
				<p class="bento-card__text">
					AIによるコード生成が当たり前になる時代だからこそ、人間のエンジニアには「課題の定義」「UI/UXの細部の磨き込み」「適切な技術選定とアーキテクチャ設計」が求められると考えています。
				</p>
				<p class="bento-card__text">
					今後はプログラミングの基礎とソフトウェア設計への理解をさらに深め、チーム開発の中でフロントエンドを軸にバックエンドやインフラ領域まで主体的に携われるエンジニアへ成長していきます。
				</p>
			</article>

			<article class="bento-card bento-card--full">
				<span class="bento-card__label">04. Skill Set / 技術スタック・対応領域</span>
				<h2 class="bento-card__title">実務で使用している言語・ツール・知見</h2>
				<div class="skills-columns">
					{
						skillGroups.map((group) => (
							<div class="skill-group">
								<h3 class="skill-group__title">{group.category}</h3>
								<ul class="skill-group__list">
									{group.items.map((skill) => (
										<li class="skill-row">
											<span class="skill-row__name">{skill.name}</span>
											<span class="skill-row__detail">{skill.detail}</span>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</article>

			<article class="bento-card bento-card--full education-card">
				<div>
					<span class="bento-card__label">05. Education / 学歴</span>
					<ul class="edu-list">
						<li>
							<strong>サイバー大学</strong>
							<span>2025年4月 — 2028年3月 卒業予定</span>
						</li>
						<li>
							<strong>神奈川工科大学 電気電子情報学科</strong>
							<span>2023年4月 — 2024年3月</span>
						</li>
					</ul>
				</div>
				<a href="/#works" class="btn btn-lg">
					制作実績一覧へ戻る
					<Icon name="ph:arrow-right" class="arrow" aria-hidden="true" />
				</a>
			</article>
		</div>
	</section>
</Base>

<style>
	.about-hero {
		padding-block: clamp(64px, 10vw, 120px) clamp(32px, 5vw, 56px);
	}

	.about-title {
		margin-top: 12px;
		font-size: clamp(36px, 5vw, 60px);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.about-subtitle {
		margin-top: 12px;
		font-size: 16px;
		font-weight: 500;
		color: var(--color-accent);
	}

	.about-lead {
		max-width: 68ch;
		margin-top: 24px;
		font-size: clamp(16px, 1.7vw, 18px);
		line-height: 1.8;
		color: var(--color-text-secondary);
	}

	.bento-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.bento-card {
		padding: clamp(24px, 3.5vw, 40px);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.bento-card--wide {
		grid-row: span 2;
	}

	.bento-card--full {
		grid-column: 1 / -1;
	}

	.bento-card--accent {
		background: var(--glow-daylight), var(--color-sunken);
		border: 1px solid var(--color-border);
	}

	.bento-card__label {
		display: inline-block;
		font-size: 12.5px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--color-muted);
	}

	.bento-card__title {
		margin-top: 10px;
		font-size: clamp(20px, 2.2vw, 26px);
		font-weight: 600;
		line-height: 1.35;
	}

	.bento-card__text {
		margin-top: 16px;
		font-size: 15px;
		line-height: 1.75;
		color: var(--color-text-secondary);
	}

	.timeline {
		display: grid;
		gap: 32px;
		margin-top: 28px;
	}

	.timeline-item {
		padding-left: 20px;
		border-left: 2px solid var(--color-border-strong);
	}

	.timeline-item__period {
		font-size: 13px;
		font-weight: 500;
		color: var(--color-accent);
	}

	.timeline-item__company {
		margin-top: 4px;
		font-size: 19px;
		font-weight: 600;
	}

	.timeline-item__role {
		margin-top: 2px;
		font-size: 14px;
		color: var(--color-text-secondary);
	}

	.timeline-item__list {
		display: grid;
		gap: 8px;
		margin-top: 14px;
	}

	.timeline-item__list li {
		position: relative;
		padding-left: 16px;
		font-size: 14.5px;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.timeline-item__list li::before {
		content: "";
		position: absolute;
		top: 0.65em;
		left: 0;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.style-list {
		display: grid;
		gap: 20px;
		margin-top: 24px;
	}

	.style-item h3 {
		font-size: 16.5px;
		font-weight: 600;
	}

	.style-item p {
		margin-top: 6px;
		font-size: 14px;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}

	.skills-columns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 28px;
		margin-top: 28px;
	}

	.skill-group__title {
		padding-bottom: 10px;
		border-bottom: 1px solid var(--color-border);
		font-size: 16px;
		font-weight: 600;
	}

	.skill-group__list {
		display: grid;
		gap: 16px;
		margin-top: 16px;
	}

	.skill-row {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.skill-row__name {
		font-size: 14.5px;
		font-weight: 600;
		color: var(--color-text);
	}

	.skill-row__detail {
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	.education-card {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.edu-list {
		display: flex;
		flex-wrap: wrap;
		gap: 24px 48px;
		margin-top: 14px;
	}

	.edu-list li {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.edu-list strong {
		font-size: 16px;
		font-weight: 600;
	}

	.edu-list span {
		font-size: 14px;
		color: var(--color-text-secondary);
	}

	@media (max-width: 960px) {
		.bento-grid,
		.skills-columns {
			grid-template-columns: 1fr;
		}

		.bento-card--wide {
			grid-row: auto;
		}
	}
</style>