---
const skillGroups = [
	{
		group: "Production / 実務で日常的に使用",
		items: [
			{ name: "HTML / CSS", note: "セマンティック設計・レスポンシブ・アニメーション実装" },
			{ name: "JavaScript", note: "DOM操作・非同期処理・インタラクション実装" },
			{ name: "HubSpot CMS / HubL", note: "カスタムモジュール設計・fields.jsonによる運用基盤構築" },
			{ name: "Node.js / GAS", note: "スプレッドシート連携・制作業務の自動化スクリプト開発" },
			{ name: "Figma", note: "UI設計・コンポーネント整理・デザイン意図の汲み取り" },
		],
	},
	{
		group: "Exploring / 個人開発・検証で活用",
		items: [
			{ name: "Astro / EmDash", note: "本ポートフォリオの設計・CMS連携・パフォーマンス最適化" },
			{ name: "TypeScript / React", note: "型安全なフロントエンド開発・コンポーネント設計の学習" },
			{ name: "JSON-LD / Technical SEO", note: "構造化データ設計・生成AI（AEO）を意識した情報設計" },
			{ name: "Git / GitHub", note: "ブランチ運用・プルリクエストベースのチーム開発" },
		],
	},
];

const timeline = [
	{
		period: "2025.05 - 現在",
		role: "長期インターン / フロントエンド・CMS実装",
		summary: "B2B企業のWebサイト・オウンドメディアの仕組み化と改善を担当。",
		points: [
			"HubSpot CMSの汎用LPテンプレートおよびカスタムモジュール群を設計・実装",
			"Node.js・GASを活用したデータ連携・ファイル反映の自動化ツールを構築",
			"SEO・AEOを見据えたJSON-LD構造化データの動的出力テンプレートを整備",
		],
	},
	{
		period: "2023.04 - 現在",
		role: "Web制作・UI/UX設計・ディレクション",
		summary: "クライアント案件の設計から実装、チーム進行まで一貫して経験。",
		points: [
			"Figmaを用いたワイヤーフレーム・UI設計とレスポンシブ実装",
			"制作メンバーへのタスク切り出し・コードレビュー・進行管理を担当",
			"デザイン意図と実装コストのバランスを取り、納品後の運用しやすさまで提案",
		],
	},
];

const principles = [
	{
		num: "01",
		title: "「作って終わり」にしない仕組み化",
		desc: "目の前の1ページを実装するだけでなく、次に更新する人やチーム全体が迷わず運用できるモジュール設計・自動化を常に意識しています。",
	},
	{
		num: "02",
		title: "仮説と検証を高速に回す自走力",
		desc: "未知の技術やエラーに直面した際は、公式ドキュメントと生成AIを併用して原因を切り分け、小さく動くプロトタイプを作って検証します。",
	},
	{
		num: "03",
		title: "デザインとエンジニアリングの橋渡し",
		desc: "UI設計とディレクションの経験を活かし、デザイナーの意図やユーザーの心地よさをコードで丁寧に再現することを大切にしています。",
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>About | 齋藤 条太郎</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- スクロール進捗ライン -->
		<div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

		<!-- スモーキー背景 + 粒子ノイズ -->
		<div class="ambient" aria-hidden="true">
			<div class="ambient__blob ambient__blob--1"></div>
			<div class="ambient__blob ambient__blob--2"></div>
			<div class="ambient__grain"></div>
		</div>

		<!-- カスタムカーソル -->
		<div class="ring-cursor" id="ring-cursor" aria-hidden="true">
			<span class="ring-cursor__label" id="ring-cursor-label"></span>
		</div>

		<header class="site-header">
			<a href="/" class="brand" data-cursor="Top">齋藤 条太郎</a>
			<nav class="site-nav">
				<a href="/" data-cursor="Index">01 Index</a>
				<a href="/about" class="is-current" data-cursor="About">02 About</a>
			</nav>
		</header>

		<main class="wrap">
			<!-- Hero: ロード時の文字リビール -->
			<section class="hero">
				<span class="kicker hero-fade" style="--d: 0ms">Profile / 28卒 フロントエンドエンジニア志望</span>
				<h1 class="title">
					<span class="mask-line"><span class="mask-line__inner" style="--d: 80ms">齋藤 条太郎</span></span>
				</h1>
				<p class="lead hero-fade" style="--d: 180ms">
					運用しやすい仕組みと、心地よいUI体験を実装するフロントエンドエンジニアを目指しています。
					長期インターンや実務でのCMS設計・業務自動化・ディレクション経験を土台に、
					設計意図を深く汲み取りプロダクトの価値を高める開発に取り組んでいます。
				</p>
			</section>

			<!-- 01. 開発スタンス（時間差で下から浮き上がる） -->
			<section class="sec">
				<div class="sec-head" data-reveal="up">
					<span class="kicker">01 / Engineering Principles</span>
					<h2 class="sec-title">開発で大切にしていること</h2>
				</div>
				<div class="principle-grid">
					{
						principles.map((p, idx) => (
							<div class="principle-card" data-reveal="up" style={`--d: ${idx * 100}ms`}>
								<span class="p-num">{p.num}</span>
								<h3>{p.title}</h3>
								<p>{p.desc}</p>
							</div>
						))
					}
				</div>
			</section>

			<!-- 02. 経歴（左からスライドイン） -->
			<section class="sec">
				<div class="sec-head" data-reveal="up">
					<span class="kicker">02 / Experience</span>
					<h2 class="sec-title">実務・インターン経験</h2>
				</div>
				<div class="timeline">
					{
						timeline.map((item, idx) => (
							<div class="tl-row" data-reveal="left" style={`--d: ${idx * 120}ms`}>
								<span class="tl-period">{item.period}</span>
								<div>
									<h3>{item.role}</h3>
									<p class="tl-summary">{item.summary}</p>
									<ul class="tl-points">
										{item.points.map((pt) => (
											<li>{pt}</li>
										))}
									</ul>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<!-- 03. スキル習熟度別（行ごとに順番にフェードイン） -->
			<section class="sec">
				<div class="sec-head" data-reveal="up">
					<span class="kicker">03 / Skills &amp; Stack</span>
					<h2 class="sec-title">技術スタックと活用領域</h2>
				</div>
				<div class="skill-groups">
					{
						skillGroups.map((g) => (
							<div class="skill-group" data-reveal="up">
								<h3>{g.group}</h3>
								<div class="skill-list">
									{g.items.map((item, idx) => (
										<div class="skill-row" data-reveal="up" style={`--d: ${idx * 55}ms`}>
											<span class="skill-name">{item.name}</span>
											<span class="skill-note">{item.note}</span>
										</div>
									))}
								</div>
							</div>
						))
					}
				</div>
			</section>

			<footer class="foot" data-reveal="up">
				<a href="/" class="back-link" data-cursor="Back">← Indexへ戻る</a>
				<span>© 2026 齋藤 条太郎</span>
			</footer>
		</main>

		<script>
			// 1. カスタムカーソル
			const ring = document.getElementById("ring-cursor");
			const ringLabel = document.getElementById("ring-cursor-label");
			if (ring && window.matchMedia("(pointer: fine)").matches) {
				let tx = window.innerWidth / 2;
				let ty = window.innerHeight / 2;
				let cx = tx;
				let cy = ty;

				document.addEventListener("mousemove", (e) => {
					tx = e.clientX;
					ty = e.clientY;
					ring.classList.add("is-visible");
				});

				const tickCursor = () => {
					cx += (tx - cx) * 0.15;
					cy += (ty - cy) * 0.15;
					ring.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%)`;
					requestAnimationFrame(tickCursor);
				};
				tickCursor();

				document.querySelectorAll<HTMLElement>("[data-cursor], a").forEach((el) => {
					el.addEventListener("mouseenter", () => {
						ring.classList.add("is-hover");
						if (ringLabel) ringLabel.textContent = el.dataset.cursor || "";
					});
					el.addEventListener("mouseleave", () => {
						ring.classList.remove("is-hover");
						if (ringLabel) ringLabel.textContent = "";
					});
				});
			}

			// 2. スクロール進捗バー
			const progressBar = document.getElementById("scroll-progress");
			const updateProgress = () => {
				if (!progressBar) return;
				const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
				const ratio = Math.min(Math.max(window.scrollY / max, 0), 1);
				progressBar.style.transform = `scaleX(${ratio})`;
			};
			window.addEventListener("scroll", updateProgress, { passive: true });
			updateProgress();

			// 3. スクロール連動リビール（安全に確実に表示される設計）
			const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");
			if ("IntersectionObserver" in window) {
				revealTargets.forEach((el) => el.classList.add("is-ready"));
				const io = new IntersectionObserver(
					(entries, obs) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-in");
								obs.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
				);
				revealTargets.forEach((el) => io.observe(el));
			}
		</script>

		<style>
			:root {
				--bg: #111112;
				--surface: rgba(255, 255, 255, 0.04);
				--ink: #f0efe9;
				--ink-2: rgba(240, 239, 233, 0.74);
				--muted: rgba(240, 239, 233, 0.44);
				--line: rgba(240, 239, 233, 0.14);
				--ease: cubic-bezier(0.16, 1, 0.3, 1);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: "Inter", "Noto Sans JP", sans-serif;
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			/* 進捗バー */
			.scroll-progress {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 200;
				width: 100%;
				height: 2px;
				background: var(--ink);
				transform-origin: left center;
				transform: scaleX(0);
				will-change: transform;
			}

			/* 背景 */
			.ambient {
				position: fixed;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				overflow: hidden;
				background: radial-gradient(circle at 20% 80%, #26272b 0%, #121214 55%, #0c0c0d 100%);
			}

			.ambient__blob {
				position: absolute;
				border-radius: 50%;
				filter: blur(120px);
				opacity: 0.4;
				animation: drift 22s ease-in-out infinite alternate;
			}

			.ambient__blob--1 {
				width: 55vw;
				height: 55vw;
				right: -15vw;
				top: -15vw;
				background: radial-gradient(circle, rgba(160, 175, 200, 0.2), transparent 70%);
			}

			.ambient__blob--2 {
				width: 50vw;
				height: 50vw;
				left: -15vw;
				bottom: -20vw;
				background: radial-gradient(circle, rgba(215, 218, 224, 0.22), transparent 70%);
				animation-duration: 28s;
			}

			@keyframes drift {
				from {
					transform: translate3d(0, 0, 0) scale(1);
				}
				to {
					transform: translate3d(4vw, -4vh, 0) scale(1.08);
				}
			}

			.ambient__grain {
				position: absolute;
				inset: 0;
				opacity: 0.08;
				background-image: radial-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 0);
				background-size: 3px 3px;
			}

			/* カスタムカーソル */
			.ring-cursor {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 900;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				border: 1px solid rgba(240, 239, 233, 0.35);
				pointer-events: none;
				opacity: 0;
				display: grid;
				place-items: center;
				transition:
					width 260ms var(--ease),
					height 260ms var(--ease),
					background-color 260ms var(--ease),
					opacity 220ms var(--ease);
			}

			.ring-cursor.is-visible {
				opacity: 1;
			}

			.ring-cursor.is-hover {
				width: 72px;
				height: 72px;
				background: rgba(240, 239, 233, 0.1);
				border-color: rgba(240, 239, 233, 0.75);
			}

			.ring-cursor__label {
				font-family: "JetBrains Mono", monospace;
				font-size: 10px;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}

			/* ヘッダー */
			.site-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 20px clamp(20px, 4vw, 48px);
				border-bottom: 1px solid var(--line);
				background: rgba(17, 17, 18, 0.65);
				backdrop-filter: blur(12px);
			}

			.brand {
				font-family: "Noto Serif JP", serif;
				font-size: 15px;
				letter-spacing: 0.12em;
			}

			.site-nav {
				display: flex;
				gap: 24px;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--ink-2);
			}

			.site-nav .is-current,
			.site-nav a:hover {
				color: var(--ink);
			}

			/* Hero アニメーション */
			.mask-line {
				display: block;
				overflow: hidden;
				padding-bottom: 0.08em;
			}

			.mask-line__inner {
				display: block;
				animation: slide-up-mask 900ms var(--ease) var(--d, 0ms) both;
			}

			.hero-fade {
				animation: fade-up 850ms var(--ease) var(--d, 0ms) both;
			}

			@keyframes slide-up-mask {
				from {
					transform: translateY(105%);
					opacity: 0;
				}
				to {
					transform: translateY(0);
					opacity: 1;
				}
			}

			@keyframes fade-up {
				from {
					transform: translateY(18px);
					opacity: 0;
				}
				to {
					transform: translateY(0);
					opacity: 1;
				}
			}

			/* スクロールリビール */
			[data-reveal].is-ready {
				opacity: 0;
				transition:
					opacity 750ms var(--ease) var(--d, 0ms),
					transform 750ms var(--ease) var(--d, 0ms);
			}

			[data-reveal="up"].is-ready {
				transform: translateY(26px);
			}

			[data-reveal="left"].is-ready {
				transform: translateX(-28px);
			}

			[data-reveal].is-in {
				opacity: 1;
				transform: translate3d(0, 0, 0);
			}

			/* レイアウト */
			.wrap {
				position: relative;
				z-index: 2;
				width: min(980px, calc(100% - clamp(32px, 6vw, 96px)));
				margin-inline: auto;
				padding: 132px 0 88px;
			}

			.kicker {
				display: inline-block;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				letter-spacing: 0.1em;
				color: var(--muted);
				text-transform: uppercase;
			}

			.title {
				margin: 14px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: clamp(36px, 6vw, 64px);
				font-weight: 500;
				letter-spacing: 0.1em;
			}

			.lead {
				max-width: 62ch;
				margin: 24px 0 0;
				font-size: 15.5px;
				line-height: 1.95;
				color: var(--ink-2);
			}

			.sec {
				margin-top: 76px;
				padding-top: 32px;
				border-top: 1px solid var(--line);
			}

			.sec-title {
				margin: 10px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: 24px;
				font-weight: 500;
			}

			.principle-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 18px;
				margin-top: 26px;
			}

			.principle-card {
				padding: 24px;
				border-radius: 14px;
				background: var(--surface);
				border: 1px solid var(--line);
				transition:
					transform 320ms var(--ease),
					border-color 320ms var(--ease),
					background-color 320ms var(--ease),
					opacity 750ms var(--ease) var(--d, 0ms);
			}

			.principle-card:hover {
				transform: translateY(-4px);
				border-color: rgba(240, 239, 233, 0.34);
				background: rgba(255, 255, 255, 0.065);
			}

			.p-num {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
			}

			.principle-card h3 {
				margin: 10px 0 0;
				font-size: 16px;
				font-weight: 500;
				line-height: 1.45;
			}

			.principle-card p {
				margin: 10px 0 0;
				font-size: 13.5px;
				line-height: 1.8;
				color: var(--ink-2);
			}

			.timeline {
				margin-top: 24px;
			}

			.tl-row {
				display: grid;
				grid-template-columns: 180px minmax(0, 1fr);
				gap: 24px;
				padding-block: 28px;
				border-bottom: 1px solid var(--line);
			}

			.tl-period {
				font-family: "JetBrains Mono", monospace;
				font-size: 12px;
				color: var(--muted);
			}

			.tl-row h3 {
				margin: 0;
				font-size: 18px;
				font-weight: 500;
			}

			.tl-summary {
				margin: 8px 0 0;
				font-size: 14px;
				color: var(--ink-2);
			}

			.tl-points {
				margin: 14px 0 0;
				padding-left: 18px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				font-size: 14px;
				line-height: 1.75;
				color: var(--ink-2);
			}

			.skill-groups {
				display: flex;
				flex-direction: column;
				gap: 28px;
				margin-top: 26px;
			}

			.skill-group {
				padding: 24px 28px;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid var(--line);
			}

			.skill-group h3 {
				margin: 0 0 16px;
				font-family: "JetBrains Mono", "Noto Sans JP", monospace;
				font-size: 13px;
				font-weight: 500;
				color: var(--muted);
			}

			.skill-list {
				display: flex;
				flex-direction: column;
			}

			.skill-row {
				display: grid;
				grid-template-columns: 200px minmax(0, 1fr);
				gap: 16px;
				padding: 13px 0;
				border-top: 1px solid var(--line);
				font-size: 14px;
				transition:
					padding-left 280ms var(--ease),
					background-color 280ms var(--ease),
					opacity 750ms var(--ease) var(--d, 0ms),
					transform 750ms var(--ease) var(--d, 0ms);
			}

			.skill-row:hover {
				padding-left: 12px;
				background: rgba(255, 255, 255, 0.03);
			}

			.skill-name {
				font-family: "JetBrains Mono", monospace;
				font-weight: 500;
			}

			.skill-note {
				color: var(--ink-2);
			}

			.foot {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 84px;
				padding-top: 20px;
				border-top: 1px solid var(--line);
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
