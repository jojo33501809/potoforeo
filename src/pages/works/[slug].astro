---
interface WorkDetail {
	slug: string;
	title: string;
	summary: string;
	category: string;
	role: string;
	period: string;
	year: string;
	tools: string[];
	thumbnail: string;
	siteUrl?: string;
	githubUrl?: string;
	challenge: string;
	approach: string[];
	result: string;
}

export function getStaticPaths() {
	const works: WorkDetail[] = [
		{
			slug: "hubspot-modular-lp",
			title: "HubSpot CMS 汎用LPテンプレート設計",
			summary: "非エンジニアでも管理画面から柔軟にページ構築できる再利用可能なモジュール群を設計・実装。",
			category: "CMS / Architecture",
			role: "Design, Code",
			period: "2025.05 - 現在",
			year: "2025",
			tools: ["HubSpot CMS", "HubL", "JavaScript", "fields.json"],
			thumbnail: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1400&q=80",
			siteUrl: "",
			githubUrl: "",
			challenge:
				"LP制作のたびにエンジニアがHTML/CSSを書き換える運用になっており、公開までのリードタイムとレイアウト崩れのリスクが課題でした。",
			approach: [
				"セクション単位で並び替え・複製が可能なカスタムモジュール群を設計",
				"fields.jsonの入力項目と表示条件を整理し、管理画面から直感的に編集できるUIを構築",
				"レスポンシブ崩れを防ぐCSS設計と共通トークン化を実施",
			],
			result:
				"非エンジニアの担当者だけでも新規LPの立ち上げから文言・画像修正まで完結できる運用基盤を実現しました。",
		},
		{
			slug: "workflow-automation-gas-node",
			title: "Node.js・GASによる制作業務自動化",
			summary: "スプレッドシートの設定データとWebページ情報の自動連携およびファイル反映フローを構築。",
			category: "Automation",
			role: "Tooling, Code",
			period: "2025.08 - 現在",
			year: "2025",
			tools: ["Node.js", "GAS", "JSON", "Git"],
			thumbnail: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1400&q=80",
			siteUrl: "",
			githubUrl: "",
			challenge:
				"複数ページの設定値やメタ情報をスプレッドシートから手動で転記する作業が発生しており、工数負荷とヒューマンエラーの温床になっていました。",
			approach: [
				"GASでスプレッドシートのデータを構造化JSONとして整形・出力する仕組みを作成",
				"Node.jsスクリプトでローカルのテンプレートファイルへ自動反映・差分チェックを実装",
				"Gitでの変更履歴確認と組み合わせ、安全に一括更新できるフローを整備",
			],
			result:
				"手作業による転記ミスをなくし、複数ページの更新作業にかかる時間を大幅に短縮しました。",
		},
		{
			slug: "b2b-aeo-structured-data",
			title: "B2Bメディア SEO・AEO構造化データ実装",
			summary: "検索エンジン・生成AI双方での認知向上を目指したJSON-LD実装とオウンドメディア運用。",
			category: "AEO / Technical SEO",
			role: "Strategy, Code",
			period: "2025.05 - 現在",
			year: "2025",
			tools: ["JSON-LD", "Search Console", "HubSpot"],
			thumbnail: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=1400&q=80",
			siteUrl: "",
			githubUrl: "",
			challenge:
				"従来の検索順位だけでなく、生成AIによる回答（AEO）でも自社コンテンツの文脈や信頼性が正しく認識される情報構造が求められていました。",
			approach: [
				"記事種別やFAQ・パンくずリストに応じたJSON-LD構造化データの動的出力テンプレートを実装",
				"見出し階層とセマンティックHTMLを見直し、クローラーとLLM双方が解釈しやすい構造に整理",
				"Search Consoleでのリッチリザルト検出・エラー監視を継続運用",
			],
			result:
				"構造化データのエラーゼロを維持しつつ、検索エンジンからのページ理解度と流入の安定化に貢献しました。",
		},
		{
			slug: "client-web-ui-direction",
			title: "クライアントWebサイト UI/UX設計・進行管理",
			summary: "Figmaを用いたUI設計からレスポンシブ実装、制作チームの進行ディレクション・育成まで担当。",
			category: "UI/UX & Direction",
			role: "Direction, Design, Code",
			period: "2023.04 - 現在",
			year: "2024",
			tools: ["Figma", "HTML/CSS", "JavaScript", "React"],
			thumbnail: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1400&q=80",
			siteUrl: "",
			githubUrl: "",
			challenge:
				"デザインと実装の認識ズレによる手戻りを減らし、複数メンバーで品質を保ちながら納期通りに進行する体制づくりが必要でした。",
			approach: [
				"Figma上でコンポーネント設計とブレイクポイントの仕様を明文化し、実装前提のUIを設計",
				"タスクの細分化・スケジュール管理および実装メンバーへのコードレビューを実施",
				"クライアントへの意図説明と改善提案を一貫して担当",
			],
			result:
				"デザイン再現度と実装品質を両立させながら、手戻りの少ないスムーズなサイト公開を実現しました。",
		},
	];

	return works.map((work) => ({
		params: { slug: work.slug },
		props: { work },
	}));
}

const { work } = Astro.props as { work: WorkDetail };
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{work.title} | 齋藤 条太郎</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="ambient" aria-hidden="true">
			<div class="ambient__blob"></div>
			<div class="ambient__grain"></div>
		</div>

		<header class="site-header">
			<a href="/" class="brand">齋藤 条太郎</a>
			<nav class="site-nav">
				<a href="/">01 Index</a>
				<a href="/about">02 About</a>
			</nav>
		</header>

		<main class="wrap">
			<a href="/" class="back-top">← Selected Worksへ戻る</a>

			<div class="hero" data-reveal>
				<div class="meta">
					<span>{work.year}</span>
					<span>—</span>
					<span>{work.category}</span>
				</div>
				<h1 class="title">{work.title}</h1>
				<p class="summary">{work.summary}</p>

				{(work.siteUrl || work.githubUrl) && (
					<div class="ext-links">
						{work.siteUrl && (
							<a href={work.siteUrl} target="_blank" rel="noreferrer" class="ext-btn">
								公開サイトを見る ↗
							</a>
						)}
						{work.githubUrl && (
							<a href={work.githubUrl} target="_blank" rel="noreferrer" class="ext-btn ext-btn--ghost">
								GitHub ↗
							</a>
						)}
					</div>
				)}
			</div>

			<div class="cover" data-reveal>
				<img src={work.thumbnail} alt={work.title} />
			</div>

			<dl class="specs" data-reveal>
				<div>
					<dt>Role</dt>
					<dd>{work.role}</dd>
				</div>
				<div>
					<dt>Period</dt>
					<dd>{work.period}</dd>
				</div>
				<div>
					<dt>Stack / Tools</dt>
					<dd>{work.tools.join(" / ")}</dd>
				</div>
			</dl>

			<section class="case-sec" data-reveal>
				<h2>01 / Background &amp; Challenge</h2>
				<p>{work.challenge}</p>
			</section>

			<section class="case-sec" data-reveal>
				<h2>02 / Architecture &amp; Approach</h2>
				<ul>
					{work.approach.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</section>

			<section class="case-sec" data-reveal>
				<h2>03 / Outcome</h2>
				<p>{work.result}</p>
			</section>

			<footer class="foot">
				<a href="/" class="back-bottom">← 実績一覧へ戻る</a>
				<a href="mailto:jojosaito1809@gmail.com">jojosaito1809@gmail.com</a>
			</footer>
		</main>

		<script>
			const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
			if ("IntersectionObserver" in window) {
				targets.forEach((el) => el.classList.add("is-ready"));
				const io = new IntersectionObserver(
					(entries, obs) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-in");
								obs.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.08 },
				);
				targets.forEach((el) => io.observe(el));
			}
		</script>

		<style>
			:root {
				--bg: #f8fafc;
				--surface: rgba(255, 255, 255, 0.9);
				--ink: #0f172a;
				--ink-2: #334155;
				--muted: #64748b;
				--navy: #1e3a8a;
				--line: rgba(15, 23, 42, 0.12);
				--ease: cubic-bezier(0.22, 1, 0.36, 1);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: "Inter", "Noto Sans JP", sans-serif;
				-webkit-font-smoothing: antialiased;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.ambient {
				position: fixed;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				background: radial-gradient(circle at 20% 80%, #eef2ff 0%, #f8fafc 55%, #ffffff 100%);
			}

			.ambient__blob {
				position: absolute;
				width: 55vw;
				height: 55vw;
				right: -15vw;
				top: -15vw;
				border-radius: 50%;
				filter: blur(120px);
				opacity: 0.45;
				background: radial-gradient(circle, rgba(30, 58, 138, 0.14), transparent 70%);
			}

			.ambient__grain {
				position: absolute;
				inset: 0;
				opacity: 0.04;
				background-image: radial-gradient(rgba(15, 23, 42, 0.6) 1px, transparent 0);
				background-size: 3px 3px;
			}

			.site-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 20px clamp(20px, 4vw, 48px);
				border-bottom: 1px solid var(--line);
				background: rgba(248, 250, 252, 0.82);
				backdrop-filter: blur(12px);
			}

			.brand {
				font-family: "Noto Serif JP", serif;
				font-size: 15px;
				letter-spacing: 0.12em;
				color: var(--ink);
			}

			.site-nav {
				display: flex;
				gap: 24px;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--ink-2);
			}

			.site-nav a:hover {
				color: var(--navy);
			}

			[data-reveal].is-ready {
				opacity: 0;
				transform: translateY(22px);
				transition:
					opacity 950ms var(--ease),
					transform 950ms var(--ease);
			}

			[data-reveal].is-in {
				opacity: 1;
				transform: translateY(0);
			}

			.wrap {
				position: relative;
				z-index: 2;
				width: min(880px, calc(100% - clamp(32px, 6vw, 96px)));
				margin-inline: auto;
				padding: 124px 0 88px;
			}

			.back-top {
				display: inline-block;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--navy);
			}

			.meta {
				display: flex;
				gap: 10px;
				margin-top: 28px;
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--navy);
			}

			.title {
				margin: 14px 0 0;
				font-family: "Noto Serif JP", serif;
				font-size: clamp(28px, 4.5vw, 46px);
				font-weight: 500;
				line-height: 1.35;
			}

			.summary {
				max-width: 60ch;
				margin: 18px 0 0;
				font-size: 15.5px;
				line-height: 1.9;
				color: var(--ink-2);
			}

			.ext-links {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 24px;
			}

			.ext-btn {
				display: inline-flex;
				align-items: center;
				padding: 10px 22px;
				border-radius: 999px;
				background: var(--navy);
				color: #ffffff;
				font-size: 13px;
				font-weight: 500;
			}

			.ext-btn--ghost {
				background: #ffffff;
				color: var(--navy);
				border: 1px solid rgba(30, 58, 138, 0.25);
			}

			.cover {
				margin-top: 36px;
				border-radius: 16px;
				overflow: hidden;
				border: 1px solid var(--line);
				aspect-ratio: 16 / 9;
				background: #e2e8f0;
				box-shadow: 0 20px 44px rgba(15, 23, 42, 0.08);
			}

			.cover img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.specs {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 20px;
				margin: 32px 0 0;
				padding: 22px 24px;
				border-radius: 14px;
				background: var(--surface);
				border: 1px solid var(--line);
			}

			.specs dt {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--navy);
			}

			.specs dd {
				margin: 6px 0 0;
				font-size: 13.5px;
				color: var(--ink);
			}

			.case-sec {
				margin-top: 48px;
				padding-top: 28px;
				border-top: 1px solid var(--line);
			}

			.case-sec h2 {
				margin: 0;
				font-family: "JetBrains Mono", monospace;
				font-size: 13px;
				font-weight: 500;
				color: var(--navy);
			}

			.case-sec p,
			.case-sec ul {
				margin: 16px 0 0;
				font-size: 15px;
				line-height: 1.9;
				color: var(--ink-2);
			}

			.case-sec ul {
				padding-left: 20px;
				display: flex;
				flex-direction: column;
				gap: 10px;
			}

			.foot {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 76px;
				padding-top: 20px;
				border-top: 1px solid var(--line);
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--muted);
			}

			.back-bottom {
				color: var(--navy);
				border-bottom: 1px solid var(--navy);
				padding-bottom: 2px;
			}

			@media (max-width: 768px) {
				.specs {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>